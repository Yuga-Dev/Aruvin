{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["shared/**/*.ts", "aurvin/**/*.ts", "livekit-agents/**/*.ts",
    "deepgram-agent/**/*.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules", "results", "audio"]
}
